# Copy this file to .env.local and fill in a real key.
DEEPSEEK_API_KEY=请在这里粘贴你的sk开头的密钥

# Optional override. The API route defaults to deepseek-flash.
# DEEPSEEK_MODEL=deepseek-flash

# Optional outbound proxy for YouTube caption requests (leave unset when YouTube is directly reachable).
# YOUTUBE_PROXY=http://127.0.0.1:7897
