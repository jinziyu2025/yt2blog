# Copy this file to .env.local and fill in a real key.
DEEPSEEK_API_KEY=请在这里粘贴你的sk开头的密钥

# Optional override. The API route defaults to deepseek-flash.
# DEEPSEEK_MODEL=deepseek-flash

# YouTube captions are fetched through open-source YouTube mirror APIs
# (lib/invidious.ts). Invidious is asked first, then Piped as a fallback.
# Override with comma-separated lists when a mirror goes down.
# INVIDIOUS_INSTANCES=https://inv.nadeko.net,https://yewtu.be
# PIPED_INSTANCES=https://api.piped.private.coffee,https://pipedapi.kavin.rocks
