# Copy this file to .env.local and fill in a real key.
DEEPSEEK_API_KEY=请在这里粘贴你的sk开头的密钥

# Optional override. The API route defaults to deepseek-flash.
# DEEPSEEK_MODEL=deepseek-flash

# Optional outbound proxy for YouTube caption requests. When set, it is used as
# the last resort after the random free proxies from the public pool.
# YOUTUBE_PROXY=http://127.0.0.1:7897

# Free proxy pool (lib/youtube-proxy.ts) - enabled by default.
# Set YOUTUBE_PROXY_POOL=0 to request YouTube directly without rotating proxies.
# YOUTUBE_PROXY_POOL=1
# YOUTUBE_PROXY_ATTEMPTS=3
# YOUTUBE_PROXY_TIMEOUT_MS=10000
