# Copy this file to .env.local and fill in a real key.
DEEPSEEK_API_KEY=请在这里粘贴你的sk开头的密钥

# Optional override. The API route defaults to deepseek-flash.
# DEEPSEEK_MODEL=deepseek-flash

# YouTube captions come from Supadata (https://supadata.ai). Required:
# get a key from the Supadata dashboard and paste it here.
# SUPADATA_API_KEY=sd_你的密钥

# Paddle checkout. Optional: while unset, the paywall shows the
# "Redirecting to Paddle Checkout..." placeholder instead of opening checkout.
# Both values are client-side by design (Paddle.js needs them in the browser).
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxxxxxx
# NEXT_PUBLIC_PADDLE_PRICE_ID=pri_xxxxxxxx

# Supabase (Project Settings -> API). Both are client-side; RLS keeps writes
# limited to insert + public read. Without them, articles stay in localStorage
# and /article/[id] is used instead of /blog/[slug].
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxx

# Public origin used by metadata, canonical URLs, sitemap and robots.
# NEXT_PUBLIC_SITE_URL=https://yt2blog.org
